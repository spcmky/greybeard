# Copy to greybeard.env and fill in. Used by docker-compose.yml.
# See docs/SETUP.md for what each var does.

# --- Model provider -------------------------------------------------------
# Anthropic (simplest): set the API key and leave GREYBEARD_PROVIDER unset.
ANTHROPIC_API_KEY=sk-ant-...
# GREYBEARD_LENS_MODEL=claude-opus-5

# Bedrock instead? Uncomment these and mount ~/.aws in docker-compose.yml.
# GREYBEARD_PROVIDER=bedrock
# GREYBEARD_LENS_MODEL=us.anthropic.claude-opus-5
# AWS_REGION=us-east-2

# --- GitHub ---------------------------------------------------------------
# Local one-shot `review`: a user token is enough.
# GITHUB_TOKEN=ghp_...

# Automatic review (serve): required — must match the GitHub App webhook secret.
GREYBEARD_WEBHOOK_SECRET=change-me

# GitHub App identity (comments post as the bot). Mount the .pem in compose and
# point GREYBEARD_APP_PRIVATE_KEY at the in-container path.
# GREYBEARD_APP_ID=123456
# GREYBEARD_APP_PRIVATE_KEY=/secrets/greybeard.pem
# GREYBEARD_BOT_LOGIN=greybeard-bot[bot]

# --- Guardrails (serve, optional) -----------------------------------------
# GREYBEARD_MAX_CONCURRENT=2
# GREYBEARD_DAILY_REVIEW_LIMIT=50
# GREYBEARD_REVIEW_BOT_PRS=false
